<%- include('../partials/header', { narrow: true }) %>

<div class="auth-hero">
  <div class="brand-mark"><i class="fa-solid fa-key"></i></div>
  <h1>Forgot password?</h1>
  <p>We'll email you a link to reset it</p>
</div>

<%- include('../partials/flash') %>

<section class="card">
  <% if (formSubmitted) { %>
    <div class="center">
      <p class="alert alert-success" style="justify-content: center">
        <i class="fa-solid fa-envelope-circle-check"></i>
        <span>Check your inbox</span>
      </p>
      <p class="muted" style="margin-top: 14px">
        If an account exists for that email, a reset link is on its way.
        The link expires in 15 minutes.
      </p>
      <a href="/login" class="btn btn-ghost btn-block" style="margin-top: 18px">Back to log in</a>
    </div>
  <% } else { %>
    <form class="form" action="/reset-password" method="post">
      <div class="field">
        <label class="field-label" for="email">Email</label>
        <div class="input-wrap">
          <i class="fa-solid fa-envelope"></i>
          <input class="input" type="email" name="email" id="email" required
            autocomplete="email" inputmode="email" autocapitalize="off"
            placeholder="you@example.com" />
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
    </form>
  <% } %>
</section>

<p class="auth-switch">
  Remembered it? <a href="/login">Log in</a>
</p>

<%- include('../partials/footer') %>

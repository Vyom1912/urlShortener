<%- include('../partials/header', { narrow: true }) %>

<div class="auth-hero">
  <div class="brand-mark"><i class="fa-solid fa-link"></i></div>
  <h1>Welcome back</h1>
  <p>Log in to manage your short links</p>
</div>

<%- include('../partials/flash') %>

<section class="card">
  <form class="form" action="/login" method="POST">
    <div class="field">
      <label class="field-label" for="email">Email</label>
      <div class="input-wrap">
        <i class="fa-solid fa-envelope"></i>
        <input class="input" type="email" name="email" id="email" required
          autocomplete="email" inputmode="email" autocapitalize="off"
          placeholder="you@example.com" value="<%= old.email || '' %>" />
      </div>
    </div>

    <%- include('../partials/password-field', {
      id: 'password',
      name: 'password',
      label: 'Password',
      autocomplete: 'current-password',
      aside: '<a href="/reset-password">Forgot password?</a>',
    }) %>

    <button type="submit" class="btn btn-primary btn-block">Log in</button>
  </form>
</section>

<p class="auth-switch">
  Don't have an account? <a href="/register">Create one</a>
</p>

<%- include('../partials/footer') %>

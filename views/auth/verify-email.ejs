<%- include('../partials/header', { narrow: true }) %>

<div class="auth-hero">
  <div class="brand-mark"><i class="fa-solid fa-envelope-open-text"></i></div>
  <h1>Verify your email</h1>
  <p>We sent an 8-digit code to <strong><%= email %></strong></p>
</div>

<%- include('../partials/flash') %>

<section class="card">
  <form class="form" action="/verify-email-token" method="get">
    <div class="field">
      <label class="field-label" for="token">Verification code</label>
      <div class="input-wrap">
        <input class="input code-input" type="text" name="token" id="token"
          inputmode="numeric" autocomplete="one-time-code" maxlength="8"
          pattern="[0-9]{8}" title="Enter the 8-digit code" required placeholder="00000000" />
      </div>
    </div>
    <input type="hidden" name="email" value="<%= email %>" />
    <button type="submit" class="btn btn-primary btn-block">Verify</button>
  </form>
</section>

<form action="/resend-verification-link" method="post" class="auth-switch">
  Didn't get it?
  <button type="submit" class="btn btn-sm btn-ghost" style="margin-left: 6px">
    <i class="fa-solid fa-rotate-right"></i> Resend email
  </button>
</form>

<%- include('../partials/footer') %>

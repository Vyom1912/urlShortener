<%- include('../partials/header', { narrow: true }) %>

<%- include('../partials/flash') %>

<section class="card">
  <div class="profile-head">
    <div class="avatar-lg"><%= profile.name.charAt(0).toUpperCase() %></div>
    <div>
      <h1><%= profile.name %></h1>
      <p>@<%= profile.handle %> · <%= profile.email %></p>
    </div>
  </div>

  <div class="stats">
    <div class="stat">
      <span class="stat-value"><%= profile.linksCount %></span>
      <span class="stat-label">Links</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= profile.totalClicks %></span>
      <span class="stat-label">Clicks</span>
    </div>
    <div class="stat">
      <span class="stat-value">
        <%= profile.createdAt ? new Date(profile.createdAt).toLocaleDateString("en-GB", { month: "short", year: "2-digit" }) : "—" %>
      </span>
      <span class="stat-label">Joined</span>
    </div>
  </div>

  <div class="verify-row">
    <span class="muted">Email</span>
    <% if (profile.isEmailValid) { %>
      <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> Verified</span>
    <% } else { %>
      <span class="badge badge-warning"><i class="fa-solid fa-circle-exclamation"></i> Not verified</span>
      <a href="/verify-email" class="btn btn-sm btn-primary" style="width: 100%">
        <i class="fa-solid fa-paper-plane"></i> Verify now
      </a>
    <% } %>
  </div>
</section>

<section class="card menu">
  <a href="/edit-profile">
    <i class="fa-regular fa-pen-to-square"></i> Edit profile
    <i class="fa-solid fa-chevron-right"></i>
  </a>
  <a href="/change-password">
    <i class="fa-solid fa-key"></i> Change password
    <i class="fa-solid fa-chevron-right"></i>
  </a>
  <hr />
  <a href="/logout" class="danger">
    <i class="fa-solid fa-arrow-right-from-bracket"></i> Log out
  </a>
</section>

<%- include('../partials/footer') %>

<div class="field">
  <label class="field-label" for="<%= id %>">
    <span><%= label %></span>
    <% if (locals.aside) { %><%- aside %><% } %>
  </label>
  <div class="input-wrap">
    <i class="fa-solid fa-lock"></i>
    <input
      class="input"
      type="password"
      name="<%= name %>"
      id="<%= id %>"
      placeholder="<%= locals.placeholder || '••••••••' %>"
      autocomplete="<%= locals.autocomplete || 'current-password' %>"
      <% if (locals.minlength) { %>minlength="<%= minlength %>"<% } %>
      required />
    <button type="button" class="input-action" data-toggle-password="<%= id %>" aria-label="Show password">
      <i class="fa-regular fa-eye"></i>
    </button>
  </div>
  <% if (locals.hint) { %><span class="field-hint"><%= hint %></span><% } %>
</div>

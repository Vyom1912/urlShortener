<%- include('partials/header', { narrow: true }) %>
<% const code = locals.status || 404; %>

<section class="status-page">
  <div class="status-code"><%= code %></div>
  <h1><%= locals.title || "Page not found" %></h1>
  <p>
    <%= locals.message || (code === 404
      ? "This link doesn't exist or may have been removed."
      : "Something went wrong on our side. Please try again.") %>
  </p>
  <a href="/" class="btn btn-primary"><i class="fa-solid fa-house"></i> Go home</a>
</section>

<%- include('partials/footer') %>
